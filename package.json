{
  "name": "maze-bot",
  "version": "0.1.0",
  "description": "Wheely's maze: browser port of the maze-bot sim and policies",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./web": "./web/src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p web --noEmit",
    "dev": "vite --config web/dev/vite.config.ts",
    "build:dev": "vite build --config web/dev/vite.config.ts --outDir ../../.devbuild --emptyOutDir"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "files": [
    "web/src/",
    "presets/presets.json",
    "artifacts/release/versions/v3-rookie/weights.json",
    "artifacts/release/versions/v4-owl-eyes/weights.json",
    "artifacts/release/versions/final/weights.json"
  ],
  "sideEffects": "false"
}
